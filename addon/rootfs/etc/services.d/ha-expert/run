#!/usr/bin/with-contenv bashio
set -euo pipefail

CLIENT_LOGIN="$(bashio::config 'client_login')"
HA_TOKEN="$(bashio::config 'ha_token')"

export PATH="/opt/ha_expert/venv/bin:${PATH}"
export HA_EXPERT_OPERATOR_URL="${HA_EXPERT_OPERATOR_URL:-http://100.109.244.70:8788}"
export HA_EXPERT_INTERNAL_HA_URL="http://homeassistant:8123"
export HA_EXPERT_INTERNAL_HA_PORT="8123"
export HA_EXPERT_TAILSCALE_AUTHKEY="${HA_EXPERT_TAILSCALE_AUTHKEY:-}"
export HA_EXPERT_TAILSCALE_AUTHKEY_FILE="${HA_EXPERT_TAILSCALE_AUTHKEY_FILE:-/data/ha_expert_tailscale_authkey}"
export HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE="${HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE:-/homeassistant/.ha_expert/ha_expert_tailscale_authkey}"
export HA_EXPERT_TAILSCALE_BOOTSTRAP_KEY_FILE="${HA_EXPERT_TAILSCALE_BOOTSTRAP_KEY_FILE:-/opt/ha_expert/bootstrap/ha_expert_tailscale_authkey}"
export HA_EXPERT_TAILSCALE_BOOTSTRAP_ENC_FILE="${HA_EXPERT_TAILSCALE_BOOTSTRAP_ENC_FILE:-/opt/ha_expert/bootstrap/ha_expert_tailscale_authkey.enc}"
export HA_EXPERT_TAILSCALE_BOOTSTRAP_DECODER="${HA_EXPERT_TAILSCALE_BOOTSTRAP_DECODER:-/opt/ha_expert/bootstrap/bootstrap_key.py}"
export HA_EXPERT_TAILSCALE_TAG="${HA_EXPERT_TAILSCALE_TAG:-tag:ha-expert-client}"
export HA_EXPERT_TAILSCALE_HOST_PREFIX="${HA_EXPERT_TAILSCALE_HOST_PREFIX:-ha-expert}"
export HA_EXPERT_TAILSCALE_STATE_DIR="${HA_EXPERT_TAILSCALE_STATE_DIR:-/data/tailscale}"
export HA_EXPERT_TAILSCALE_SOCKET="${HA_EXPERT_TAILSCALE_SOCKET:-/data/tailscale/tailscaled.sock}"
export HA_EXPERT_TAILSCALE_SOCKS5_SERVER="${HA_EXPERT_TAILSCALE_SOCKS5_SERVER:-127.0.0.1:1055}"
export HA_EXPERT_TAILSCALE_HTTP_PROXY="${HA_EXPERT_TAILSCALE_HTTP_PROXY:-http://127.0.0.1:1056}"
export HA_EXPERT_CLIENT_LOGIN="${CLIENT_LOGIN}"
export HA_EXPERT_HA_TOKEN="${HA_TOKEN}"

mkdir -p "$(dirname "${HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE}")"

if [[ ! -s "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}" ]]; then
  if [[ -s "${HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE}" ]]; then
    cp "${HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE}" "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}"
    chmod 600 "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}"
  elif [[ ! -s "${HA_EXPERT_TAILSCALE_BOOTSTRAP_KEY_FILE}" && -s "${HA_EXPERT_TAILSCALE_BOOTSTRAP_ENC_FILE}" && -f "${HA_EXPERT_TAILSCALE_BOOTSTRAP_DECODER}" ]]; then
    python3 "${HA_EXPERT_TAILSCALE_BOOTSTRAP_DECODER}" "${HA_EXPERT_TAILSCALE_BOOTSTRAP_ENC_FILE}" "${HA_EXPERT_TAILSCALE_BOOTSTRAP_KEY_FILE}"
    chmod 600 "${HA_EXPERT_TAILSCALE_BOOTSTRAP_KEY_FILE}"
  elif [[ -s "${HA_EXPERT_TAILSCALE_BOOTSTRAP_KEY_FILE}" ]]; then
    cp "${HA_EXPERT_TAILSCALE_BOOTSTRAP_KEY_FILE}" "${HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE}"
    chmod 600 "${HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE}"
    cp "${HA_EXPERT_TAILSCALE_BOOTSTRAP_KEY_FILE}" "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}"
    chmod 600 "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}"
  fi
fi

if [[ -z "${HA_EXPERT_TAILSCALE_AUTHKEY}" && -s "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}" ]]; then
  HA_EXPERT_TAILSCALE_AUTHKEY="$(tr -d '\r\n' < "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}")"
  export HA_EXPERT_TAILSCALE_AUTHKEY
fi

if [[ -n "${HA_EXPERT_TAILSCALE_AUTHKEY}" ]]; then
  if [[ ! -s "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}" ]]; then
    printf '%s' "${HA_EXPERT_TAILSCALE_AUTHKEY}" > "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}"
    chmod 600 "${HA_EXPERT_TAILSCALE_AUTHKEY_FILE}"
  fi

  if [[ ! -s "${HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE}" ]]; then
    printf '%s' "${HA_EXPERT_TAILSCALE_AUTHKEY}" > "${HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE}"
    chmod 600 "${HA_EXPERT_TAILSCALE_PERSISTENT_KEY_FILE}"
  fi
fi

exec python3 /opt/ha_expert/app.py
